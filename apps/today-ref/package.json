{
  "name": "today-ref",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gallery": "pnpm --filter today-ref-gallery dev",
    "check": "node scripts/check.ts",
