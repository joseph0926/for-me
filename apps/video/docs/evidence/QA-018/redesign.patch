+@Composable
+private fun LibraryScaffold(modifier: Modifier, activeTab: Int, select: (Int) -> Unit,
+    content: @Composable ColumnScope.() -> Unit) {
+    BoxWithConstraints(modifier.fillMaxSize()) {
+        val sideNavigation = maxWidth >= 600.dp && maxHeight < 500.dp
+        Row(Modifier.fillMaxSize()) {
+            if (sideNavigation) {
+                Column(Modifier.fillMaxHeight().width(84.dp).selectableGroup().padding(vertical = 8.dp),
+                    horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Center) {
+                    destinations.forEach { (icon, label) ->
+                        NavigationRailItem(selected = label == activeTab, onClick = { select(label) },
+                            icon = { Icon(painterResource(icon), null, Modifier.size(21.dp)) },
+                            label = { Text(stringResource(label)) },
+                            colors = NavigationRailItemDefaults.colors(indicatorColor = MaterialTheme.colorScheme.primaryContainer))
+                    }
+                }
+                VerticalDivider()
+            }
+            Column(Modifier.weight(1f).fillMaxHeight(), horizontalAlignment = Alignment.CenterHorizontally) {
+                content()
+                if (!sideNavigation) {
+                    HorizontalDivider()
+                    Row(Modifier.widthIn(max = 560.dp).fillMaxWidth().selectableGroup().padding(4.dp)) {
+                        destinations.forEach { (icon, label) ->
+                            NavigationBarItem(selected = label == activeTab, onClick = { select(label) },
+                                icon = { Icon(painterResource(icon), null, Modifier.size(21.dp)) },
+                                label = { Text(stringResource(label), style = MaterialTheme.typography.labelMedium) },
+                                colors = NavigationBarItemDefaults.colors(indicatorColor = MaterialTheme.colorScheme.primaryContainer,
+                                    selectedIconColor = MaterialTheme.colorScheme.onPrimaryContainer,
+                                    selectedTextColor = MaterialTheme.colorScheme.primary))
+                        }
+                    }
+                }
+            }
+        }
+    }
