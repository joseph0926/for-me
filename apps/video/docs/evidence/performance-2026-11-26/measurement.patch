+package dev.forme.video
+
+import android.content.Context
+import android.os.SystemClock
+import android.util.Log
+import androidx.core.content.FileProvider
+import dev.forme.video.data.PlaybackRecord
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+internal object Bench {
+    val cardsReady = kotlinx.coroutines.CompletableDeferred<Unit>()
+    private var cards = 0
+    fun cardReady() {
+        log("CARD_READY")
+        if (stage == "home" && ++cards >= 2) cardsReady.complete(Unit)
+    }
+    @Volatile var stage = "prepare"
+    fun log(message: String) {
+        Log.i("SceneMeasure", "$stage $message")
+    }
+    fun mark(value: String) {
+        stage = value
+        log("MARK")
+    }
+    suspend fun seed(context: Context, model: VideoViewModel): android.net.Uri {
+        val dir = File(context.filesDir, "trial")
+        val video = File(dir, "ab-video.mp4")
+        val srt = File(dir, "ab-cues.srt")
+        withContext(Dispatchers.IO) {
+            dir.mkdirs()
+            if (!video.exists()) context.assets.open(video.name).use { input -> video.outputStream().use { input.copyTo(it) } }
+            if (!srt.exists()) context.assets.open(srt.name).use { input -> srt.outputStream().use { input.copyTo(it) } }
+        }
+        fun uri(file: File) = FileProvider.getUriForFile(context, context.packageName + ".files", file)
+        val selected = uri(video)
+        context.getSharedPreferences("video_subtitles", Context.MODE_PRIVATE).edit()
+            .putString("track:$selected", "external")
+            .putString("external:$selected", uri(srt).toString()).apply()
+        model.repository.save(PlaybackRecord(selected.toString(), video.name, 0L, 18000L, 1L))
+        check(model.repository.find(selected.toString())?.positionMs == 0L)
+        return selected
+    }
+}
